<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A minimal platform theme. The Compose UI is themed by MMD's ThemeMMD at
      runtime; this XML theme only needs to be a valid, action-bar-less host.
    -->
    <style name="Theme.MindfulAnki" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
    </style>
</resources>
